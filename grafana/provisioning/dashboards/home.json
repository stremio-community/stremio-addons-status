{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "time": { "from": "now-7d", "to": "now" },
  "timezone": "",
  "title": "Stremio Addons",
  "uid": "stremio-addons-home",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "5m",
  "tags": ["stremio", "kener"],
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Fleet uptime (selected range)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "kener-postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE d.status = 'UP') / NULLIF(count(*) FILTER (WHERE d.status IN ('UP', 'DOWN', 'DEGRADED')), 0) AS uptime FROM monitoring_data d JOIN monitors m ON m.tag = d.monitor_tag WHERE m.category_name IN ('Addons', 'Addon Instances') AND m.is_hidden = 'NO' AND $__unixEpochFilter(d.timestamp)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Addons UP (latest check)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "kener-postgres" },
      "fieldConfig": {
        "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "green" } }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS up FROM monitors m JOIN LATERAL (SELECT status FROM monitoring_data d WHERE d.monitor_tag = m.tag ORDER BY d.timestamp DESC LIMIT 1) r ON true WHERE m.category_name IN ('Addons', 'Addon Instances') AND m.is_hidden = 'NO' AND m.status = 'ACTIVE' AND r.status = 'UP'"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Addons DOWN (latest check)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "kener-postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS down FROM monitors m JOIN LATERAL (SELECT status FROM monitoring_data d WHERE d.monitor_tag = m.tag ORDER BY d.timestamp DESC LIMIT 1) r ON true WHERE m.category_name IN ('Addons', 'Addon Instances') AND m.is_hidden = 'NO' AND m.status = 'ACTIVE' AND r.status = 'DOWN'"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Monitored addons",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "kener-postgres" },
      "fieldConfig": {
        "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "blue" } }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        { "refId": "A", "format": "table", "rawSql": "SELECT count(*) AS total FROM monitors WHERE category_name IN ('Addons', 'Addon Instances') AND is_hidden = 'NO' AND status = 'ACTIVE'" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fleet uptime over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "postgres", "uid": "kener-postgres" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', to_timestamp(d.timestamp)) AS time, 100.0 * count(*) FILTER (WHERE d.status = 'UP') / NULLIF(count(*) FILTER (WHERE d.status IN ('UP', 'DOWN', 'DEGRADED')), 0) AS \"uptime %\" FROM monitoring_data d JOIN monitors m ON m.tag = d.monitor_tag WHERE m.category_name IN ('Addons', 'Addon Instances') AND m.is_hidden = 'NO' AND $__unixEpochFilter(d.timestamp) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average response time over time",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "postgres", "uid": "kener-postgres" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT date_trunc('hour', to_timestamp(d.timestamp)) AS time, avg(d.latency) AS \"avg response (ms)\" FROM monitoring_data d JOIN monitors m ON m.tag = d.monitor_tag WHERE m.category_name IN ('Addons', 'Addon Instances') AND m.is_hidden = 'NO' AND $__unixEpochFilter(d.timestamp) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "type": "table",
      "title": "Health by category",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "postgres", "uid": "kener-postgres" },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Latest Up %" },
            "properties": [
              { "id": "unit", "value": "percent" },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "orange", "value": 90 },
                    { "color": "green", "value": 99 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Latest Up %", "desc": false }]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT m.category_name AS \"Category\", count(*) AS \"Addons\", count(*) FILTER (WHERE r.status = 'UP') AS \"Up\", count(*) FILTER (WHERE r.status = 'DOWN') AS \"Down\", round(100.0 * count(*) FILTER (WHERE r.status = 'UP') / NULLIF(count(*), 0), 1) AS \"Latest Up %\" FROM monitors m JOIN LATERAL (SELECT status FROM monitoring_data d WHERE d.monitor_tag = m.tag ORDER BY d.timestamp DESC LIMIT 1) r ON true WHERE m.is_hidden = 'NO' AND m.status = 'ACTIVE' GROUP BY 1 ORDER BY 5 ASC NULLS LAST"
        }
      ]
    }
  ]
}
