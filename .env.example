# --- Ports (host side) ---
KENER_PORT=3002
GATUS_PORT=8080
GRAFANA_PORT=3000

# --- Public URLs ---
# Public URL of the Kener status page (required by Kener for CSRF protection).
# In prod set this to https://status.stremio-addons.net after cutover.
KENER_PUBLIC_URL=http://localhost:3002
# Base URL of the public Grafana, used by the "Grafana" header button on the status page.
# In prod set this to the public Grafana URL (e.g. https://stats.example.com).
GRAFANA_PUBLIC_URL=http://localhost:3000

# --- Postgres (shared by Kener + Gatus + Grafana) ---
POSTGRES_USER=gatus
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=gatus

# --- Kener ---
# Kener's own database inside the shared Postgres instance.
# One-time setup: docker compose exec postgres createdb -U $POSTGRES_USER kener
KENER_DB=kener
# Session/crypto secret; generate with: openssl rand -base64 32
KENER_SECRET_KEY=change-me-kener-secret
# API key the worker uses for the Kener v4 API.
# Created once in the Kener manage UI: Settings -> API Keys (needs monitor + page write access).
KENER_API_TOKEN=

# --- Legacy Gatus (dual-push window only; remove after cutover) ---
# Bearer token the worker uses to push external-endpoint verdicts to Gatus.
PUSH_TOKEN=change-me-push-token

# --- Addons API ---
API_BASE=https://stremio-addons.net/api/v0

# --- Egress proxy ---
# Cloudflare WARP SOCKS5 proxy inside the compose network. Empty = direct (no proxy).
PROXY_URL=socks5://warp:1080

# --- Scheduling / concurrency (durations: 30s, 15m, 1h; or plain ms) ---
PROBE_INTERVAL=15m
LIST_REFRESH=1h
CONCURRENCY=8

# --- Discord alerts (legacy Gatus path; dual-push window only) ---
# Webhook for a channel in the Stremio Community server (e.g. #addon-status).
# Set it to enable down/recovery alerts via Gatus; leave empty to disable.
# Kener alerting is configured in its manage UI (Triggers), not via env.
DISCORD_WEBHOOK_URL=
