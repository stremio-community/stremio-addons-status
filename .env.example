# --- Ports (host side) ---
KUMA_PORT=3001

# --- MariaDB (Uptime Kuma's storage) ---
MARIADB_DATABASE=kuma
MARIADB_USER=kuma
MARIADB_PASSWORD=change-me-mariadb
MARIADB_ROOT_PASSWORD=change-me-mariadb-root

# --- Uptime Kuma admin account ---
# Created automatically by the worker on first boot; also your login for the Kuma admin UI.
# Kuma rejects weak passwords: use at least 8 chars with mixed case and digits.
KUMA_USERNAME=admin
KUMA_PASSWORD=change-me-Kuma-1

# --- Addons API ---
API_BASE=https://stremio-addons.net/api/v0

# --- Egress proxy ---
# Cloudflare WARP SOCKS5 proxy inside the compose network. Empty = direct (no proxy).
PROXY_URL=socks5://warp:1080

# --- Scheduling / concurrency (durations: 30s, 15m, 1h; or plain ms) ---
PROBE_INTERVAL=15m
LIST_REFRESH=1h
CONCURRENCY=8
