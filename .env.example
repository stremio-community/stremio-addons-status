# --- Ports (host side) ---
KENER_PORT=3002
GRAFANA_PORT=3000

# --- Public URLs ---
# Public URL of the Kener status page (required by Kener for CSRF protection).
# In prod set this to https://status.stremio-addons.net.
# A "Grafana" nav link on the status page is configured manually in Kener's manage UI, not via env.
KENER_PUBLIC_URL=http://localhost:3002

# --- Postgres (shared by Kener + Grafana) ---
POSTGRES_USER=kener
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=kener

# --- Kener ---
# Session/crypto secret; generate with: openssl rand -base64 32
KENER_SECRET_KEY=change-me-kener-secret
# API key the worker uses for the Kener v4 API.
# Pick any random string (e.g. openssl rand -hex 32); the kener-seed service registers it on startup.
KENER_API_TOKEN=change-me-kener-api-token
# Manage-UI admin, created automatically by the kener-seed service on first start.
# Password rules: at least 8 characters with an uppercase letter, a lowercase letter, and a digit.
# It is sent form-encoded, so avoid characters that need URL-encoding (& = % +).
KENER_ADMIN_EMAIL=admin@example.com
KENER_ADMIN_PASSWORD=change-me-Kener1

# --- Addons API ---
API_BASE=https://stremio-addons.net/api/v0

# --- Egress proxy ---
# Cloudflare WARP SOCKS5 proxy inside the compose network. Empty = direct (no proxy).
PROXY_URL=socks5://warp:1080

# --- Scheduling / concurrency (durations: 30s, 15m, 1h; or plain ms) ---
PROBE_INTERVAL=15m
LIST_REFRESH=1h
CONCURRENCY=8
