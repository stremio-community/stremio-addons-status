# --- Ports (host side) ---
GATUS_PORT=8080
GRAFANA_PORT=3000

# --- Postgres (shared by Gatus + Grafana) ---
POSTGRES_USER=gatus
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=gatus

# --- Worker <-> Gatus push auth (must match on both sides) ---
# Bearer token the worker uses to push external-endpoint verdicts.
PUSH_TOKEN=change-me-push-token

# --- Addons API ---
API_BASE=https://stremio-addons.net/api/v0

# --- Egress proxy ---
# Cloudflare WARP SOCKS5 proxy inside the compose network. Empty = direct (no proxy).
PROXY_URL=socks5://warp:1080

# --- Scheduling / concurrency (durations: 30s, 15m, 1h; or plain ms) ---
PROBE_INTERVAL=15m
LIST_REFRESH=1h
CONCURRENCY=8

# --- Discord alerts ---
# Webhook for a channel in the Stremio Community server (e.g. #addon-status).
# Set it to enable down/recovery alerts; leave empty to disable Discord notifications entirely.
DISCORD_WEBHOOK_URL=
