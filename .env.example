# --- Ports (host side) ---
KUVASZ_PORT=8080
GRAFANA_PORT=3000

# --- Postgres (shared by Kuvasz + Grafana) ---
POSTGRES_USER=kuvasz
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=kuvasz

# --- Kuvasz admin UI + API ---
KUVASZ_ADMIN_USER=admin
# Must be at least 12 characters and different from the username.
KUVASZ_ADMIN_PASSWORD=change-me-admin-password
# Grants access to Kuvasz's REST API (worker + hub). Must be at least 16 characters.
KUVASZ_API_KEY=change-me-api-key-16chars

# --- Worker -> Kuvasz push identity ---
# Seeds the per-monitor push client secrets (HMAC of the addon slug).
# Changing it re-keys every monitor, which orphans their history -- pick once and keep it.
PUSH_SECRET_SEED=change-me-push-seed

# --- Addons API ---
API_BASE=https://stremio-addons.net/api/v0

# --- Egress proxy ---
# Cloudflare WARP SOCKS5 proxy inside the compose network. Empty = direct (no proxy).
PROXY_URL=socks5://warp:1080

# --- Scheduling / concurrency (durations: 30s, 15m, 1h; or plain ms) ---
PROBE_INTERVAL=15m
LIST_REFRESH=1h
CONCURRENCY=8

# --- Discord alerts ---
# Webhook for a channel in the Stremio Community server (e.g. #addon-status).
# Set it to enable down/recovery alerts; leave empty to disable Discord notifications entirely.
DISCORD_WEBHOOK_URL=
