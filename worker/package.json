{
  "name": "worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deep-probes Stremio addons and pushes verdicts to Uptime Kuma.",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "tsx watch --env-file-if-exists=../.env --env-file-if-exists=.env.dev src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stremio-addon/sdk": "^1.0.0",
    "fetch-socks": "^1.3.3",
    "p-limit": "^6.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "socket.io-client": "^4.8.3",
    "undici": "^8.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  }
}
