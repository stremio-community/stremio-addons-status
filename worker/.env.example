# Host-run dev overrides for the worker.
# Copy to .env.dev; start:dev loads ../.env first, then these on top.
# Only override what differs when the worker runs on the host instead of in compose.
# Full config lives in the repo-root .env.example.

# Reach Kener via its published host port (KENER_PORT), not the compose service name.
KENER_URL=http://localhost:3002

# KENER_API_TOKEN comes from ../.env (same Kener instance, same key).

# Route through the WARP container via its host-published SOCKS5 port (see compose.yaml).
# Set empty to probe directly instead.
PROXY_URL=socks5://localhost:1080
